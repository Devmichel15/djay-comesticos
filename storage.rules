rules_version = '2';

// ============================================================================
// FIREBASE STORAGE SECURITY RULES - Djay Cosméticos
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    
    // ========================================================================
    // PRODUCTS IMAGES - Admin can upload/update/delete
    // ========================================================================
    match /produtos/{productId}/{allPaths=**} {
      // ✅ READ: Anyone can view product images
      allow read: if true;
      
      // ✅ WRITE: Only authenticated admins can upload/update/delete
      allow write: if request.auth != null 
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // ========================================================================
    // USER PROFILE IMAGES (future)
    // ========================================================================
    match /users/{userId}/{allPaths=**} {
      // ✅ READ: Anyone can view
      allow read: if true;
      
      // ✅ WRITE: Only the user themselves
      allow write: if request.auth != null 
                   && request.auth.uid == userId;
    }
    
    // ========================================================================
    // DEFAULT: DENY ALL
    // ========================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
